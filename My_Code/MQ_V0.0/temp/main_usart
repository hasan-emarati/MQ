#include "stm8.h"
#include "gpio.h"
#include <string.h>
#include <stdint.h>

#define LED_PORT     GPIO_PORT_PD
#define LED_PIN      PIN4

#define RELAY_PORT   GPIO_PORT_PC
#define RELAY_PIN    PIN3

#define TR_PORT      GPIO_PORT_PA
#define TR_PIN       PIN3

#define INPUT_PORT   GPIO_PORT_PC
#define INPUT_PIN    PIN5



void delay(unsigned long count) {
    while (count--)
        nop();
}

int uart_write(const char *str) {
    char i;
    for(i = 0; i < strlen(str); i++) {
        while(!(UART1_SR & UART_SR_TXE)); // !Transmit data register empty
        UART1_DR = str[i];
    }
    return(i); // Bytes sent
}

int main(void)
{
    CLK_ECKR |= CLK_ECKR_HSEEN;
    while(!(CLK_ECKR & CLK_ECKR_HSERDY));
    
    CLK_SWR = CLK_SWR_HSE;
    CLK_SWCR |= CLK_SWCR_SWEN;
    while(CLK_SWCR & CLK_SWCR_SWBSY);
    
    CLK_CKDIVR = 0x00;


        // Setup UART1 (TX=D5)
    UART1_CR2 |= UART_CR2_TEN; // Transmitter enable
    // UART1_CR2 |= UART_CR2_REN; // Receiver enable
    UART1_CR3 &= ~(UART_CR3_STOP1 | UART_CR3_STOP2); // 1 stop bit
    // 9600 baud: UART_DIV = 16000000/9600 ~ 1667 = 0x0683
    UART1_BRR2 = 0x03; UART1_BRR1 = 0x68; // 0x0683 coded funky way (see ref manual)
    
    GPIO_Init(LED_PORT, LED_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(RELAY_PORT, RELAY_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(TR_PORT, TR_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(INPUT_PORT, INPUT_PIN, GPIO_MODE_INPUT_PULL_UP, GPIO_SPEED_SLOW);
    

    while(1) 
    {
        uart_write("Hello World!\r\n");
        delay(400000L);


        if(GPIO_Read(INPUT_PORT, INPUT_PIN) == 0) {
            GPIO_WriteLow(LED_PORT, LED_PIN);
        } else {
            GPIO_WriteHigh(LED_PORT, LED_PIN); 
        }
    }
}
