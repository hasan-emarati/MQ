#include "stm8.h"
#include "gpio.h"
#include <string.h>
#include <stdint.h>

#define LED_PORT     GPIO_PORT_PD
#define LED_PIN      PIN4

#define RELAY_PORT   GPIO_PORT_PC
#define RELAY_PIN    PIN3

#define TR_PORT      GPIO_PORT_PA
#define TR_PIN       PIN3

#define INPUT1_PORT   GPIO_PORT_PC
#define INPUT1_PIN    PIN5

#define INPUT2_PORT  GPIO_PORT_PC
#define INPUT2_PIN   PIN6

void delay(unsigned long count) {
    while (count--)
        nop();
}

int uart_write(const char *str) {
    char i;
    for(i = 0; i < strlen(str); i++) {
        while(!(UART1_SR & UART_SR_TXE)); // Wait for TX buffer empty
        UART1_DR = str[i];
    }
    return(i); // Return bytes sent
}

// Non-blocking UART receive function
char uart_read_nonblocking(void) {
    if(UART1_SR & UART_SR_RXNE) { // Check if data received
        return UART1_DR; // Return received character
    }
    return 0; // No data available
}

int main(void)
{
    // Configure HSE clock
    CLK_ECKR |= CLK_ECKR_HSEEN;
    while(!(CLK_ECKR & CLK_ECKR_HSERDY)); // Wait for HSE ready
    
    CLK_SWR = CLK_SWR_HSE; // Select HSE as system clock
    CLK_SWCR |= CLK_SWCR_SWEN; // Enable switch
    while(CLK_SWCR & CLK_SWCR_SWBSY); // Wait for switch complete
    
    CLK_CKDIVR = 0x00; // Set clock divider to 1

    // Setup UART1 (TX=D5, RX=D6)
    UART1_CR2 |= UART_CR2_TEN; // Enable transmitter
    UART1_CR2 |= UART_CR2_REN; // Enable receiver
    UART1_CR3 &= ~(UART_CR3_STOP1 | UART_CR3_STOP2); // 1 stop bit
    // 9600 baud: UART_DIV = 16000000/9600 ~ 1667 = 0x0683
    UART1_BRR2 = 0x03; 
    UART1_BRR1 = 0x68;
    
    // Initialize GPIO pins
    GPIO_Init(LED_PORT, LED_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(RELAY_PORT, RELAY_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(TR_PORT, TR_PIN, GPIO_MODE_OUTPUT_PUSH_PULL_LOW, GPIO_SPEED_SLOW);
    GPIO_Init(INPUT1_PORT, INPUT1_PIN, GPIO_MODE_INPUT_PULL_UP, GPIO_SPEED_SLOW);
    GPIO_Init(INPUT2_PORT, INPUT2_PIN, GPIO_MODE_INPUT_PULL_UP, GPIO_SPEED_SLOW); // PC6 as input
    
    // Initial startup message
    uart_write("System Ready! Send '1' to see a message.\r\n");
    
    while(1) 
    {
        // Check for received character
        char received = uart_read_nonblocking();
        
        if(received == '1') {
            // Print message when '1' is received
            uart_write("Received number 1!\r\n");
            // Blink LED as visual feedback
            GPIO_WriteLow(LED_PORT, LED_PIN);
            delay(100000);
            GPIO_WriteHigh(LED_PORT, LED_PIN);
        }
        
        // Main task: monitor PC6 input state to control LED
        if(GPIO_Read(INPUT1_PORT, INPUT1_PIN) == 1) { // If PC6 is high
            GPIO_WriteLow(LED_PORT, LED_PIN); // LED ON
        } else {
            GPIO_WriteHigh(LED_PORT, LED_PIN); // LED OFF
        }
        
        delay(10000); // Small delay to prevent buffer overflow
    }
}